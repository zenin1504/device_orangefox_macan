on early-init
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on init
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on post-fs
    mkdir /data/vendor 0777 system system
    mkdir /data/vendor/touchconfig 0777 system system
    mount tmpfs tmpfs /data/vendor/touchconfig mode=0777,gid=1000,uid=1000
    copy /vendor/odm/firmware/tp/macan/vnd_touch_scene_config_main.xml /data/vendor/touchconfig/vnd_touch_scene_config_main.xml
    copy /vendor/odm/firmware/tp/macan/vnd_edge_touch_config_main.xml /data/vendor/touchconfig/vnd_edge_touch_config_main.xml
    copy /vendor/odm/firmware/tp/macan/vnd_touch_project_config.xml /data/vendor/touchconfig/vnd_touch_project_config.xml
    copy /vendor/odm/firmware/tp/macan/vnd_algo_config_main.xml /data/vendor/touchconfig/vnd_algo_config_main.xml
    copy /vendor/odm/firmware/tp/macan/vnd_custom_config_main.xml /data/vendor/touchconfig/vnd_custom_config_main.xml
    chmod 0777 /data/vendor/touchconfig/vnd_touch_scene_config_main.xml
    chmod 0777 /data/vendor/touchconfig/vnd_edge_touch_config_main.xml
    chmod 0777 /data/vendor/touchconfig/vnd_touch_project_config.xml
    chmod 0777 /data/vendor/touchconfig/vnd_algo_config_main.xml
    chmod 0777 /data/vendor/touchconfig/vnd_custom_config_main.xml
    chown system system /data/vendor/touchconfig/vnd_touch_project_config.xml

on post-fs-data
    mkdir /data/vendor/touch 0771 system system
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on boot
    chown system system /dev/hbp_core
    chown system system /dev/hbp0
    chown system system /dev/hbp1
    chmod 660 /dev/hbp_core
    chmod 660 /dev/hbp0
    chmod 660 /dev/hbp1
    chown system system /dev/tp_vibe_node
    chmod 0660 /dev/tp_vibe_node
    chown system system /dev/oplus_haptic
    chmod 0660 /dev/oplus_haptic

service vendor.touch-aidl-2 /odm/bin/hw/vendor-oplus-hardware-touch-V2-hbp5-service
    class hal
    user root
    group system root input everybody
    setenv LD_LIBRARY_PATH /vendor/lib64:/odm/lib64:/system/lib64
    capabilities SYS_NICE SYS_ADMIN
    interface aidl vendor.oplus.hardware.touch.IOplusTouch/default
    seclabel u:r:recovery:s0
    oneshot

on late-init
    start vendor.touch-aidl-2
